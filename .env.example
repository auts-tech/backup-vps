# ============================================================
# VPS Deploy & Backup Manager — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ============================================================

# ── Admin Login Credentials ──────────────────────────────────
# These are used to login to the web dashboard portal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ── Server Configuration ─────────────────────────────────────
PORT=9090
HOST=0.0.0.0

# ── Session Secret (used to sign auth tokens) ────────────────
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-string
